# Repo root doubles as the CNC12 install directory (c:\cncr): track only allowlisted paths.
/*

!/.claude/
/.claude/settings.local.json
!/docs/
!/tools/
/tools/__pycache__/
!/.gitattributes
!/.gitignore
!/CLAUDE.md
!/LICENSE.md
!/README.md

# CNC12 machine files. Compiler output (mpu.plc, plc.map, mpu.sym ...) stays ignored.
!/*.src
!/mfunc*.mac
!/park.mac
!/cncm.hom
!/mpucomp.exe
!/plcmsg.txt
!/language.msg
# Only the VCP and color themes under resources/; resources/wizard/ is stock Wizard content.
!/resources/
/resources/*
!/resources/vcp/
!/resources/colors/

# 63 MB vendor manual kept local-only; its .md stub is tracked.
/docs/official/centroid-cnc12-router-operator-manual.pdf
.superpowers/
