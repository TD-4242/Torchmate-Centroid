<vcp_skin>
  <row_count>13</row_count>
  <!-- Logo -->
  <image>
    <column_span>3</column_span>
    <column_start>4</column_start>
    <row_span>1</row_span>
    <row_start>1</row_start>
    <path>resources\vcp\images\acornlogo.svg</path>
  </image>
  <!-- Spindle Section -->
  <border>
    <column_span>2</column_span>
    <column_start>1</column_start>
    <fill>#00007F</fill>
    <row_span>2</row_span>
    <row_start>1</row_start>
    <outline_color>#000000</outline_color>
    <outline_thickness>2</outline_thickness>
  </border>
  <!-- Rapid/Feed Section -->
  <!-- FeedRate -->
  <border>
    <!-- Feed Rate Background -->
    <column_span>3</column_span>
    <column_start>4</column_start>
    <fill>#c6c6c6</fill>
    <row_span>3</row_span>
    <row_start>10</row_start>
    <outline_color>#000000</outline_color>
    <outline_thickness>1</outline_thickness>
    <group>feed_group</group>
  </border>
  <image>
    <!-- Feed Rate Override Text -->
    <column_span>3</column_span>
    <column_start>4</column_start>
    <row_span>1</row_span>
    <row_start>10</row_start>
    <path>resources\vcp\images\feedrate_override.svg</path>
    <group>feed_group</group>
  </image>
  <border>
    <!-- Feed Rate % Display -->
    <column_span>3</column_span>
    <column_start>4</column_start>
    <fill>Transparent</fill>
    <row_span>1</row_span>
    <row_start>10</row_start>
    <outline_color>Transparent</outline_color>
    <outline_thickness>1</outline_thickness>
    <plc_word>
      <number>31</number>
      <color>#000000</color>
      <fontsize>22</fontsize>
      <font>Sergio UI</font>
      <fontstyle>bold</fontstyle>
      <verticalalignment>bottom</verticalalignment>
      <horizontalalignment>center</horizontalalignment>
      <marginbottom>-5</marginbottom>
      <percentage>true</percentage>
    </plc_word>
    <group>feed_group</group>
  </border>
  <!-- RapidRate -->
  <border>
    <!-- Rapid Rate Background -->
    <column_span>3</column_span>
    <column_start>4</column_start>
    <fill>#012c3f</fill>
    <row_span>3</row_span>
    <row_start>10</row_start>
    <outline_color>#000000</outline_color>
    <outline_thickness>1</outline_thickness>
    <group>rapid_group</group>
  </border>
  <image>
    <!-- Rapid Rate Override Text -->
    <column_span>3</column_span>
    <column_start>4</column_start>
    <row_span>1</row_span>
    <row_start>10</row_start>
    <path>resources\vcp\images\rapid_override.svg</path>
    <group>rapid_group</group>
  </image>
  <border>
    <!-- Rapid Rate % Display -->
    <column_span>3</column_span>
    <column_start>4</column_start>
    <fill>Transparent</fill>
    <row_span>1</row_span>
    <row_start>10</row_start>
    <outline_color>Transparent</outline_color>
    <outline_thickness>1</outline_thickness>
    <plc_word>
      <number>58</number>
      <color>#ffffff</color>
      <fontsize>22</fontsize>
      <font>Sergio UI</font>
      <fontstyle>bold</fontstyle>
      <verticalalignment>bottom</verticalalignment>
      <horizontalalignment>center</horizontalalignment>
      <marginbottom>-5</marginbottom>
      <percentage>true</percentage>
    </plc_word>
    <group>rapid_group</group>
  </border>
  <!-- Cycle Cancel / Cycle Start pushbutton housing -->
  <image>
    <column_span>2</column_span>
    <column_start>1</column_start>
    <row_span>4</row_span>
    <row_start>7</row_start>
    <path>resources\vcp\images\cycle_pushbutton_housing.svg</path>
    <group>run_lamp_off_group</group>
  </image>
  <image>
    <column_span>2</column_span>
    <column_start>1</column_start>
    <row_span>4</row_span>
    <row_start>7</row_start>
    <path>resources\vcp\images\cycle_pushbutton_housing_lit.svg</path>
    <group>run_lamp_on_group</group>
  </image>
  <!-- Group Initialization -->
  <hide_group>
    <group>rapid_group</group>
    <group>run_lamp_on_group</group>
  </hide_group>
  <!-- Button Interaction -->
  <on_click>
    <opacity>100</opacity>
    <outline_color>#000000</outline_color>
  </on_click>
  <on_hover>
    <opacity>100</opacity>
    <outline_color>#ffffff</outline_color>
  </on_hover>
  <!-- Buttons -->
  <button row="1" column="1" row_span="2">spindle_toggle</button>
  <button row="1" column="2">spindle_start</button>
  <button row="1" column="3">park</button>
  <button row="2" column="2">spindle_cancel</button>
  <button row="2" column="3">set_xy0</button>
  <button row="2" column="4">set_z0</button>
  <button row="2" column="5">goto_xy0</button>
  <button row="2" column="6">reset_home</button>
  <button row="3" column="5">laser_macros</button>
  <button row="3" column="6">laser_on_off</button>
  <button row="3" column="1">change_tool</button>
  <button row="3" column="2">tool_check</button>
  <button row="4" column="1" row_span="2">jog_toggle</button>
  <button row="4" column="2">x1</button>
  <button row="5" column="2">x10</button>
  <button row="6" column="2">x100</button>
  <button row="4" column="4">y_positive</button>
  <button row="4" column="6">z_positive</button>
  <button row="5" column="3">x_negative</button>
  <button row="5" column="4">tortoise_hare</button>
  <button row="5" column="5">x_positive</button>
  <button row="6" column="4">y_negative</button>
  <button row="6" column="6">z_negative</button>
  <button row="7" column="1" column_span="2" row_span="2">cycle_cancel_pb</button>
  <button row="9" column="1" column_span="2" row_span="2">cycle_start_pb</button>
  <button row="8" column="3">single_block</button>
  <button row="9" column="3">feed_hold</button>
  <button row="10" column="4">rapid_feed</button>
  <button row="11" column="1" column_span="3" row_span="3">reset</button>
  <button row="11" column="4" group="feed_group">feedrate_negative</button>
  <button row="11" column="5" group="feed_group">feedrate_100</button>
  <button row="11" column="6" group="feed_group">feedrate_positive</button>
  <button row="12" column="4" group="feed_group">feedrate_25</button>
  <button row="12" column="5" group="feed_group">feedrate_50</button>
  <button row="12" column="6" group="feed_group">feedrate_75</button>
  <button row="11" column="4" group="rapid_group">rapidrate_negative</button>
  <button row="11" column="5" group="rapid_group">rapidrate_100</button>
  <button row="11" column="6" group="rapid_group">rapidrate_positive</button>
  <button row="12" column="4" group="rapid_group">rapidrate_25</button>
  <button row="12" column="5" group="rapid_group">rapidrate_50</button>
  <button row="12" column="6" group="rapid_group">rapidrate_75</button>
  <button row="13" column="4">utils</button>
  <button row="13" column="5">vcp_options</button>
  <button row="13" column="6">push_free</button>
</vcp_skin>